# Contenido publicado desde el panel de administracion (sitio.json).
# El navegador vuelve a preguntar cada vez: un cambio en el panel se ve al
# recargar, sin esperar a que caduque ninguna cache.
Options -Indexes
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# La carpeta privada de respaldo (si el hosting no deja escribir fuera de
# public_html) nunca se sirve.
RewriteEngine On
RewriteRule ^privado(/|$) - [F,L]
